/*
===============================================================================
SQL - 02.Bronze_Table
===============================================================================
Script Purpose:
    This script creates the 'bronze.cosmetics' table used to store the
    raw cosmetics data before any cleaning or transformation is applied.

    If the table already exists, it is dropped and recreated so that the
    Bronze layer can be loaded with a fresh table structure.

===============================================================================
*/


use CosmeticsProject
if OBJECT_ID('bronze.cosmetics','u') is not null
	drop table bronze.cosmetics 
go


create table bronze.cosmetics (
prdt_id           int,
prdt_name         varchar(300),
csf_id           int,
csf				varchar(300),
company_id           int,
company_name				varchar(300),
brand_name				varchar(300),
pr_cat_id           int,
pr_cat_name				varchar(300),
sb_cat_id           int,
sb_cat_name				varchar(300),
cas_id           int,
cas_num			varchar(300),
chem_id           int,
chem_name			varchar(300),
initial_date_report		VARCHAR(300),
recent_date_report		VARCHAR(300),
discont_date		VARCHAR(300),
chem_crte		VARCHAR(300),
chem_updt		VARCHAR(300),
chem_remove		VARCHAR(300),
chem_count		VARCHAR(300)
)
select * from bronze.cosmetics
